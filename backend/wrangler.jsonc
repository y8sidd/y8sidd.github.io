{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repomentor-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://y8sidd.github.io",
    "DAILY_SESSIONS": "200",
    "DAILY_AI_REQUESTS": "100"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "RepositorySession"
      },
      {
        "name": "QUOTAS",
        "class_name": "QuotaGuard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RepositorySession",
        "QuotaGuard"
      ]
    }
  ]
}
