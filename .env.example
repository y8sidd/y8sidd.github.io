# Public configuration only. Never put provider keys in VITE_ variables.
VITE_API_BASE_URL=http://127.0.0.1:8787
# Production: the HTTPS URL printed by Cloudflare Workers after deployment.
VITE_GITHUB_PAGES=false
# Optional public site key; pair with the backend TURNSTILE_SECRET_KEY.
VITE_TURNSTILE_SITE_KEY=
